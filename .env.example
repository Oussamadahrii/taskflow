# PostgreSQL connection string (see docker-compose.yml for a local database)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/taskflow"
# Direct (non-pooled) connection used by migrations. Same as DATABASE_URL locally;
# on Neon, use the host without "-pooler".
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/taskflow"

# Generate one with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="change-me"